---
Language: Cpp
BasedOnStyle: LLVM

# ── Layout ────────────────────────────────────────────────────────────────
ColumnLimit: 100
IndentWidth: 2
ContinuationIndentWidth: 2
TabWidth: 2
UseTab: Never

# ── Alignment ─────────────────────────────────────────────────────────────
AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: true
AlignConsecutiveMacros: true
AlignEscapedNewlines: Left
AlignTrailingComments: true
AlignOperands: Align

# ── Pointer / Reference ──────────────────────────────────────────────────
PointerAlignment: Right
DerivePointerAlignment: false

# ── Braces ────────────────────────────────────────────────────────────────
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortEnumsOnASingleLine: false

# ── Switch / Case ─────────────────────────────────────────────────────────
IndentCaseLabels: false

# ── Function declarations / calls ─────────────────────────────────────────
AlignAfterOpenBracket: Align
BinPackArguments: true
BinPackParameters: true
AllowAllParametersOfDeclarationOnNextLine: true
AllowAllArgumentsOnNextLine: true

# ── Includes ──────────────────────────────────────────────────────────────
# Google-style include ordering (strict):
#   1. Corresponding header ("foo.h" in foo.c)
#   2. C system headers (<stdio.h>)
#   3. C++ system headers (<vector>)
#   4. Other library headers (<openssl/ssl.h>, <gtest/gtest.h>, <llhttp.h>)
#   5. Project headers ("foo_private.h", <x/base/log.h>)
# Each group separated by a blank line; entries sorted alphabetically
# within each group (case-insensitive). Project headers go last so
# missing dependencies in <x/...> headers are surfaced early.
SortIncludes: CaseInsensitive
IncludeBlocks: Regroup
IncludeCategories:
  # 1. Same-directory quoted header ("foo.h") — typically the
  #    corresponding header for this .c/.cpp file.
  - Regex: '^"[^/]+\.h"$'
    Priority: 1

  # 2. C system headers — single-word <stdio.h>, <unistd.h>, and
  #    POSIX subdirectory headers <arpa/inet.h>, <netinet/in.h>,
  #    <sys/socket.h>, etc.
  - Regex: '^<[a-z_]+\.h>$'
    Priority: 2
  - Regex: '^<(arpa|net|netinet|sys|linux|netpacket)/[a-z_]+\.h>$'
    Priority: 2

  # 3. C++ system headers — angle brackets, no slash, no .h
  #    (<atomic>, <string>, <vector>).
  - Regex: '^<[^/.]+>$'
    Priority: 3

  # 4. Project headers — <x/...> public API. MUST come before the
  #    catch-all below, otherwise <x/base/log.h> gets swallowed by
  #    the "other library" rule. Goes late per strict Google
  #    convention (project headers after external libraries).
  - Regex: '^<x/'
    Priority: 5

  # 5. Other library headers — <openssl/...>, <gtest/...>,
  #    <llhttp.h> (catch-all for angle-bracket includes not matched
  #    by rules 2-4).
  - Regex: '^<.+'
    Priority: 4

  # 6. Project-internal quoted headers with paths ("foo/bar.h") —
  #    catch-all for any remaining quoted includes.
  - Regex: '^".+"$'
    Priority: 6

# ── Spaces ────────────────────────────────────────────────────────────────
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpacesInParentheses: false

# ── Breaking ──────────────────────────────────────────────────────────────
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
AlwaysBreakAfterReturnType: None

# ── Macros ────────────────────────────────────────────────────────────────
TypenameMacros:
  - XCAPI

# ── Misc ──────────────────────────────────────────────────────────────────
ReflowComments: true
SpacesBeforeTrailingComments: 1
MaxEmptyLinesToKeep: 1
